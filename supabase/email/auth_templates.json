 "mailer_templates_email_change_content": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>UniMate</title></head>\n<body style=\"margin:0;padding:0;background:#F5F6FA\"><div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">أكّد إيميلك الجديد على يونيميت</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#F5F6FA\"><tr><td align=\"center\" style=\"padding:28px 12px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:480px\"><tr><td align=\"center\" style=\"padding-bottom:16px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\"><tr><td style=\"padding-left:10px;vertical-align:middle\"><img src=\"https://unimate.my/logo.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;border-radius:11px;border:0\"></td><td style=\"vertical-align:middle;font-family:Tahoma,Arial,sans-serif;font-size:20px;font-weight:bold;color:#0E1430\" dir=\"ltr\">UniMate | يونيميت</td></tr></table></td></tr><tr><td style=\"background:#FFFFFF;border-radius:24px;padding:30px 26px;text-align:right;font-family:Tahoma,Arial,sans-serif;\" dir=\"rtl\"><div style=\"height:6px;border-radius:3px;background:#7C3AED;background-image:linear-gradient(90deg,#FFB547,#FF4F7B,#7C3AED);margin-bottom:22px\"></div><div style=\"font-size:20px;font-weight:bold;color:#0E1430;margin-bottom:8px\">تأكيد الإيميل الجديد</div><div style=\"font-size:15px;line-height:26px;color:#3B4466\">طلبت تغيّر إيميل حسابك على يونيميت لـ <b dir=\"ltr\">{{ .NewEmail }}</b>.</div><div style=\"font-size:15px;line-height:26px;color:#3B4466\">اكبس الزر عشان نأكد التغيير:</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:24px 0\"><a href=\"{{ .ConfirmationURL }}\