{
  "expo": {
    "name": "UniMate",
    "slug": "unimate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unimate",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "jo.unimate.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "لتصوير الستوري والصور وإرسالها لزملائك.",
        "NSPhotoLibraryUsageDescription": "لاختيار صور للمنشورات والمحادثات وصورة البروفايل.",
        "NSLocationWhenInUseUsageDescription": "لعرض موقعك على خريطة الجامعة وحساب الطريق لقاعتك.",
        "NSMicrophoneUsageDescription": "للرسائل الصوتية والمكالمات.",
        "CFBundleDisplayName": "UniMate",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "snapchat",
          "tel",
          "maps"
        ]
      }
    },
    "android": {
      "package": "jo.unimate.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1022",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1022",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A5C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "لعرض موقعك على خريطة الجامعة وحساب الطريق لقاعتك."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "لاختيار صور للمنشورات والمحادثات.",
          "cameraPermission": "لتصوير الستوري والصور."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}