{
  "expo": {
    "name": "UniMate",
    "slug": "unimate",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unimate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "jo.unimate.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "لتصوير الستوري والصور وإرسالها لزملائك.",
        "NSPhotoLibraryUsageDescription": "لاختيار صور للمنشورات والمحادثات وصورة البروفايل.",
        "NSLocationWhenInUseUsageDescription": "لعرض موقعك على خريطة الجامعة وحساب الطريق لقاعتك.",
        "CFBundleDisplayName": "UniMate",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "snapchat",
          "tel",
          "maps"
        ],
        "CFBundleLocalizations": [
          "ar",
          "en"
        ],
        "CFBundleDevelopmentRegion": "ar",
        "NSMicrophoneUsageDescription": "لتسجيل الرسائل الصوتية بالمحادثات وصوت فيديو الستوري.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يونيميت بيستخدم موقعك بس وإنت فاتح التطبيق، لعرضك على خريطة الجامعة.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UIRequiresFullScreen": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailsOrTextMessages",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "jo.unimate.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1022",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1022",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A5C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "لعرض موقعك على خريطة الجامعة وحساب الطريق لقاعتك.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": "يونيميت بيستخدم موقعك بس وإنت فاتح التطبيق، لعرضك على خريطة الجامعة.",
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "لاختيار صور للمنشورات والمحادثات.",
          "cameraPermission": "لتصوير الستوري والصور.",
          "microphonePermission": "لتسجيل الرسائل الصوتية بالمحادثات وصوت فيديو الستوري."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "لتسجيل الرسائل الصوتية بالمحادثات وصوت فيديو الستوري."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "runtimeVersion": "1.1.0",
    "updates": {
      "enabled": true,
      "url": "https://app.unimate.my/ota/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}